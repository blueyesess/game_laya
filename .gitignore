# Generated by `pip install -e .` -- never belongs in history.
*.egg-info/

.venv/
__pycache__/
*.pyc
logs/
_install*.log
_install*.txt

# ROMs are copyrighted and must never be committed -- including any dropped in the
# project root rather than in roms/. This project does not even commit its own homebrew
# test image: tools/make_test_rom.py regenerates it in well under a second, and an
# exception here is exactly how a real dump sneaks into a repo six months later.
*.nes
